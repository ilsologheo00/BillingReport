# App
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./billing_report.db

# Admin seed (used only the first time the app starts, when no User exists yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ION mode switch: mock | live
ION_MODE=mock

# ION live credentials (only required when ION_MODE=live)
ION_TOKEN_URL=https://ion.tdsynnex.com/oauth/token
ION_BASE_URL=https://ion.tdsynnex.com
ION_ACCOUNT_ID=
# Initial refresh_token issued from the ION admin portal (rotates after first use;
# the rotated value is then cached in ION_TOKEN_CACHE_PATH, not written back here)
ION_REFRESH_TOKEN=
ION_CUSTOMERS_PATH=/api/v3/accounts/{account_id}/customers/
ION_SUBSCRIPTIONS_PATH=/api/v3/accounts/{account_id}/subscriptions

# NinjaOne mode switch: mock | live
NINJAONE_MODE=mock

# NinjaOne live credentials (only required when NINJAONE_MODE=live)
NINJAONE_TOKEN_URL=https://app.ninjarmm.com/oauth/token
NINJAONE_BASE_URL=https://app.ninjarmm.com
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=
NINJAONE_SCOPE=monitoring
NINJAONE_SENTINELONE_MATCH=sentinelone

# Acronis mode switch: mock | live
ACRONIS_MODE=mock

# Acronis live credentials (only required when ACRONIS_MODE=live)
# ACRONIS_DATACENTER is your tenant's datacenter host, e.g. eu2-cloud.acronis.com
ACRONIS_DATACENTER=
ACRONIS_CLIENT_ID=
ACRONIS_CLIENT_SECRET=

# CORS
FRONTEND_ORIGIN=http://localhost:5173
