# App
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./billing_report.db

# Admin seed (used only the first time the app starts, when no User exists yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ION mode switch: mock | live
ION_MODE=mock

# ION live credentials (only required when ION_MODE=live)
ION_TOKEN_URL=https://api.ion.stream.one/oauth/token
ION_BASE_URL=https://api.ion.stream.one
ION_CLIENT_ID=
ION_CLIENT_SECRET=
ION_SCOPE=
ION_CUSTOMERS_PATH=/v1/customers
ION_SUBSCRIPTIONS_PATH=/v1/subscriptions

# CORS
FRONTEND_ORIGIN=http://localhost:5173
